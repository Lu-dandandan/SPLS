# macOS metadata files generated by Finder.
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and interpreter cache directories.
__pycache__/
*.py[cod]
*$py.class

# Numba writes compiled cache artifacts alongside Python bytecode.
*.nbi
*.nbc

# Local Python virtual environments.
.venv/
venv/
env/
ENV/

# Jupyter's per-user notebook checkpoint directory.
.ipynb_checkpoints/

# Test, coverage, and static-analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python package build output.
build/
dist/
*.egg-info/

# Local editor and IDE settings.
.idea/
.vscode/
*.swp
*.swo
*~
